{
    "manifest_version": 3,
    "name": "Email Writer Assistant",
    "version":"1.0",
    "description":"AI-Powered Email Writer Assistant",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "content_scripts":[
        {
            "js":["content.js"],
            "matches":["*//mail.google.com/*"],
            "css":["content.css"],
            "run_at":"document_end"
        }
    ],
    "action":{
        "default_title":"Email Writer Assistant",
        "default_icon": "mail.png"
    }
}